# The server binds to loopback by default. Set LTM_ALLOW_NETWORK=true intentionally to use another host.
LTM_HOST=127.0.0.1
LTM_PORT=3456
LTM_DATABASE_PATH=
LTM_DEMO_MODE=false
LTM_ALLOW_NETWORK=false

# NXTCODEX API Quota Monitor Configuration
NXTCODEX_API_KEY=
NXTCODEX_BASE_URL=https://nxtcodex.com/v1
NXTCODEX_QUOTA_ENDPOINT=
NXTCODEX_ACCESS_TOKEN=
NXTCODEX_SESSION_COOKIE=
