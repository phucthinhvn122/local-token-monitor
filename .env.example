# ---------------------------------------------------------------- database
# Inside Docker Compose the host is the `postgres` service name.
POSTGRES_USER=codex
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=codex_gateway
DATABASE_URL=postgresql://codex:change-me-in-production@postgres:5432/codex_gateway

# ---------------------------------------------------------------- secrets
# Both are REQUIRED and the gateway refuses to start without them.
#
#   ENCRYPTION_KEY  32 bytes, as 64 hex chars. Encrypts pool provider
#                   credentials and (unless STRICT_ONE_TIME_KEYS=true) user
#                   API keys. Losing it makes those unreadable; rotating it
#                   means re-entering every provider key and reissuing user keys.
#   SESSION_SECRET  Signs dashboard session cookies. Rotating it signs everyone out.
#
# Generate both with:
#   openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_SECRET=

# --------------------------------------------------------------- gateway
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Public origin Codex CLI will call. This is what gets baked into the
# generated config.toml, so it must be reachable from your users' machines.
PUBLIC_GATEWAY_URL=http://localhost:4000

# Origin(s) allowed to send credentialed browser requests. Comma separated.
WEB_ORIGIN=http://localhost:3000

# Dashboard session lifetime.
SESSION_TTL_HOURS=168
# true | false | auto — `auto` sets the Secure flag when PUBLIC_GATEWAY_URL is https.
COOKIE_SECURE=auto

# Store user API keys as a hash only. Stronger, but the Codex auto-setup page
# can then only generate a working config during the session that issued the
# key — after a restart an admin must rotate the key. See README → Security.
STRICT_ONE_TIME_KEYS=false

# ------------------------------------------------------- bootstrap admin
# Only used when the database contains no administrator yet. Change the
# password immediately after the first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ------------------------------------------------------ background jobs
ENABLE_BACKGROUND_JOBS=true
HEALTH_CHECK_INTERVAL_MS=300000
RETENTION_SWEEP_INTERVAL_MS=21600000

# ------------------------------------------------------------------- web
# How the Next.js server reaches the gateway. In Compose this is the service
# name; the gateway never needs to be published to the browser directly.
GATEWAY_INTERNAL_URL=http://gateway:4000
