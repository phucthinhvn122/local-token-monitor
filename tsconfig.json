{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@cgw/core": ["packages/core/src/index.ts"],
      "@cgw/db": ["packages/db/src/index.ts"],
      "@cgw/shared": ["packages/shared/src/index.ts"],
      "@cgw/shared/codex": ["packages/shared/src/codex-config.ts"],
      "@cgw/token-estimator": ["packages/token-estimator/src/index.ts"]
    }
  },
  "include": ["apps/gateway/src", "packages/*/src", "tests"],
  "exclude": ["node_modules", "apps/web", "**/dist"]
}
