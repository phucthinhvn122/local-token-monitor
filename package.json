{
  "name": "codex-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted OpenAI-compatible gateway with API key and token quota management for Codex CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucthinhvn122/local-token-monitor.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/gateway",
    "apps/web",
    "packages/core",
    "packages/db",
    "packages/shared",
    "packages/token-estimator"
  ],
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c cyan,magenta \"npm run dev -w @cgw/gateway\" \"npm run dev -w @cgw/web\"",
    "build": "npm run db:generate && npm run build -w @cgw/gateway && npm run build -w @cgw/web",
    "start": "node apps/gateway/dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:seed:demo": "tsx packages/db/src/seed-demo.ts",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "prisma": "^6.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
